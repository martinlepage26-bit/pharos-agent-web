# Local PostgreSQL (created by scripts in README)
DATABASE_URL="postgresql://pharos_ai@localhost:5432/pharos_agent?host=/opt/homebrew/var/postgresql@16"

# Optional: model provider for brief synthesis (OpenRouter).
# If unset, the key at /Users/pharos_ai/pharos/state/openrouter.key is used.
# If neither exists, briefs fall back to a deterministic template.
# OPENROUTER_API_KEY=""
# PHAROS_AGENT_MODEL="anthropic/claude-sonnet-4.5"

# Optional: read-only GitHub access for registered repos
# GITHUB_TOKEN=""
